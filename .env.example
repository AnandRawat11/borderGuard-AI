# Copy to .env for local use. Never commit .env or real credentials.
IBVAP_ENV=development
HOST=127.0.0.1
PORT=8000
DATABASE_URL=sqlite:///./ibvap.db
IBVAP_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=480
IBVAP_AES_KEY_B64=
IBVAP_CORS_ORIGINS=http://localhost:3000
IBVAP_ALLOW_GUEST_OPERATOR=false
IBVAP_STRICT_WS_AUTH=true
IBVAP_MEDIA_GRANT_TTL_SECONDS=300
IBVAP_SEED_DEMO_USERS=false
IBVAP_SEED_DEMO_ALERTS=false
IBVAP_ENABLE_SIMULATION=false
IBVAP_DEMO_ADMIN_PASSWORD=
IBVAP_DEMO_SUPERVISOR_PASSWORD=
IBVAP_DEMO_OPERATOR_PASSWORD=
IBVAP_C2_SECRET=replace-with-a-unique-c2-secret
IBVAP_C2_URL=http://127.0.0.1:8000/api/c2/mock-webhook
AI_CONFIDENCE_THRESHOLD=0.50
RULE_ENGINE_INTERVAL_SECONDS=25
IBVAP_EVENT_DEDUP_TTL_SECONDS=30
IBVAP_EVENT_DEDUP_SPATIAL_BUCKET_SIZE=10
IBVAP_EVENT_DEDUP_TIME_BUCKET_SECONDS=5
IBVAP_EVENT_DEDUP_MAX_ENTRIES=10000
IBVAP_TRACKER_LOST_TTL_SECONDS=15
IBVAP_TRACKER_LOST_MAX_SIZE=256
IBVAP_WATCHLIST_MAX_REFERENCE_BYTES=5242880
IBVAP_WATCHLIST_MAX_IMAGE_DIMENSION=4096
# Optional OpenCV FaceDetectorYN model/config; uploads fail closed when no
# OpenCV face detector capability is available.
IBVAP_FACE_DETECTOR_MODEL=
IBVAP_FACE_DETECTOR_CONFIG=
IBVAP_BLOCKCHAIN_ENABLED=false
IBVAP_BLOCKCHAIN_NETWORK=mock-chain
IBVAP_BLOCKCHAIN_RPC_URL=
IBVAP_BLOCKCHAIN_CONTRACT_ADDRESS=
IBVAP_BLOCKCHAIN_PRIVATE_KEY=
IBVAP_BLOCKCHAIN_CHAIN_ID=11155111
IBVAP_BLOCKCHAIN_CONFIRMATIONS=2
